{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${AGENTS_ROOT}/token-meter/CodexTurnHook.ps1\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
